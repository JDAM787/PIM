# Copia este archivo a apps/server/.env y ajusta los valores.
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Opción A: una sola URL (útil en AWS RDS / producción)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/pim

# Opción B: variables sueltas (coinciden con docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pim
DB_SSL=false

# true solo en desarrollo local: crea/actualiza tablas a partir de las entidades
DB_SYNCHRONIZE=true
